  "className": ""
 },
 {
  "id": "g_al",
  "type": "ui_group",
  "name": "Alertas de velocidade",
  "tab": "tab1",
  "order": 4,
  "disp": true,
  "width": "12",
  "collapse": false,
  "className": ""
 },
 {
  "id": "inj",
  "type": "inject",
  "z": "flow1",
  "name": "A cada 10 s",
  "props": [
   {
    "p": "payload"
   }
  ],
  "repeat": "10",
  "crontab": "",
  "once": true,
  "onceDelay": "1",
  "topic": "",
  "payload": "",
  "payloadType": "date",
  "x": 130,
  "y": 220,
  "wires": [
   [
    "q1",
    "q2",
    "q3",
    "q4"
   ]
  ]
 },
 {
  "id": "q1",
  "type": "postgresql",
  "z": "flow1",
  "name": "Resumo por veículo",
  "query": "SELECT veiculo_id, velocidade_max FROM resumo_veiculo ORDER BY velocidade_max DESC",
  "postgreSQLConfig": "pgcfg",
  "split": false,
  "rowsPerMsg": 1,
  "outputs": 1,
  "x": 360,
  "y": 100,
  "wires": [
   [
    "f1"
   ]
  ]
 },
 {
  "id": "q2",
  "type": "postgresql",
  "z": "flow1",
  "name": "Alertas de velocidade",
  "query": "SELECT veiculo_id AS veiculo, nome AS motorista, velocidade_kmh AS velocidade, ts AS instante FROM alerta_velocidade ORDER BY velocidade_kmh DESC LIMIT 20",
  "postgreSQLConfig": "pgcfg",
  "split": false,
  "rowsPerMsg": 1,
  "outputs": 1,
  "x": 360,
  "y": 180,
  "wires": [
   [
    "f2"
   ]
  ]
 },
 {
  "id": "q3",
  "type": "postgresql",
  "z": "flow1",
  "name": "Última meteorologia",
  "query": "SELECT temperatura_c, vento_kmh, humidade_pct, hora FROM meteo ORDER BY id_meteo DESC LIMIT 1",
  "postgreSQLConfig": "pgcfg",
  "split": false,
  "rowsPerMsg": 1,
  "outputs": 1,
  "x": 360,
  "y": 260,
  "wires": [
   [
    "f3"
   ]
  ]
 },
 {
  "id": "q4",
  "type": "postgresql",
  "z": "flow1",
  "name": "Contagens",
  "query": "SELECT (SELECT COUNT(*) FROM alerta_velocidade) AS alertas, (SELECT COUNT(*) FROM resumo_veiculo) AS veiculos, (SELECT COUNT(*) FROM motorista_viatura) AS motoristas",
  "postgreSQLConfig": "pgcfg",
  "split": false,
  "rowsPerMsg": 1,
  "outputs": 1,
  "x": 360,
  "y": 340,
  "wires": [
   [
    "f4"
   ]
  ]
 },
 {
  "id": "f1",
  "type": "function",
  "z": "flow1",
  "name": "Formatar gráfico",
  "func": "const r = msg.payload || [];\nmsg.payload = [{\n  series: ['Velocidade máx (km/h)'],\n  data: [ r.map(x => Number(x.velocidade_max)) ],\n  labels: r.map(x => x.veiculo_id)\n}];\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 600,
  "y": 100,
  "wires": [
   [
    "chart"
   ]
  ]
 },
 {
  "id": "f2",
  "type": "function",
  "z": "flow1",
  "name": "Formatar tabela",
  "func": "msg.payload = (msg.payload || []).map(x => ({\n  veiculo: x.veiculo,\n  motorista: x.motorista,\n  velocidade: Number(x.velocidade),\n  instante: x.instante\n}));\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 600,
  "y": 180,
  "wires": [
   [
    "tabela"
   ]
  ]
 },
 {
  "id": "f3",
  "type": "function",
  "z": "flow1",
  "name": "Separar meteo",
  "func": "const r = (msg.payload || [])[0];\nif (!r) return [null, null, null];\nreturn [\n  { payload: Number(r.temperatura_c) },\n  { payload: Number(r.vento_kmh) },\n  { payload: 'Leitura: ' + r.hora + ' · Humidade: ' + r.humidade_pct + '%' }\n];",
  "outputs": 3,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 600,
  "y": 260,
  "wires": [
   [
    "g_temp"
   ],
   [
    "g_vento"
   ],
   [
    "txt_meteo"
   ]
  ]
 },
 {
  "id": "f4",
  "type": "function",
  "z": "flow1",
  "name": "Formatar contagens",
  "func": "const r = (msg.payload || [])[0];\nif (!r) return null;\nmsg.payload = '<b>' + r.veiculos + '</b> veículos · <b>' + r.motoristas + '</b> motoristas · <b>' + r.alertas + '</b> alertas de velocidade';\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 600,
  "y": 340,
  "wires": [
   [
    "txt_res",
    "dbg"
   ]
  ]
 },
