-- Executar na base de dados db_logistica (PostgreSQL).
-- O job tambem executa estas instrucoes no passo "Criar tabelas".

CREATE TABLE IF NOT EXISTS motorista_viatura (
    id_motorista    INTEGER PRIMARY KEY,
    nome            VARCHAR(100),
    carta_conducao  VARCHAR(20),
    matricula       VARCHAR(20),
    categoria       VARCHAR(20),
    marca           VARCHAR(50),
    modelo          VARCHAR(50),
    tipo_carga      VARCHAR(30)
);

CREATE TABLE IF NOT EXISTS alerta_velocidade (
    id_alerta              SERIAL PRIMARY KEY,
    veiculo_id             VARCHAR(20),
    ts                     VARCHAR(30),
    velocidade_kmh         NUMERIC(6,1),
    temperatura_carga_c    NUMERIC(5,1),
    nivel_combustivel_pct  NUMERIC(5,1),
    nome                   VARCHAR(100),
    categoria              VARCHAR(20),
    tipo_carga             VARCHAR(30)
);

CREATE TABLE IF NOT EXISTS resumo_veiculo (
    veiculo_id        VARCHAR(20) PRIMARY KEY,
    n_leituras        INTEGER,
    velocidade_media  NUMERIC(8,2),
    velocidade_max    NUMERIC(6,1),
    combustivel_min   NUMERIC(5,1)
);

CREATE TABLE IF NOT EXISTS meteo (
    id_meteo         SERIAL PRIMARY KEY,
    status           VARCHAR(10),
    hora             VARCHAR(30),
    temperatura_c    NUMERIC(5,1),
    humidade_pct     NUMERIC(5,1),
    vento_kmh        NUMERIC(5,1),
    precipitacao_mm  NUMERIC(5,1),
    carregado_em     TIMESTAMP DEFAULT now()
);
</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename/><sendOneStatement>F</sendOneStatement><connection>postgresSQL</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1050</xloc><yloc>100</yloc></entry><entry><name>T5 - Carregar BD</name><description/><type>TRANS</type><filename>${Internal.Entry.Current.Directory}/T5_carregar_bd.ktr</filename><transname/><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name/><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1250</xloc><yloc>100</yloc></entry><entry><name>Sucesso</name><description/><type>SUCCESS</type><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1450</xloc><yloc>100</yloc></entry></entries><hops><hop><from>START</from><to>T1 - Motoristas</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop><hop><from>T1 - Motoristas</from><to>T2 - Viaturas</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>T2 - Viaturas</from><to>T3 - Telemetria</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>T3 - Telemetria</from><to>T4 - Meteo (API)</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>T4 - Meteo (API)</from><to>Criar tabelas BD</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>Criar tabelas BD</from><to>T5 - Carregar BD</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop><hop><from>T5 - Carregar BD</from><to>Sucesso</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop></hops><notepads></notepads></job>
