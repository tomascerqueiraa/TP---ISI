  <step>
    <name>Matricula valida? (regex)</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Motoristas limpos</send_true_to>
    <send_false_to>Rejeitados motoristas</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>matricula</leftvalue>
        <function>REGEXP</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>^[0-9]{2}-[A-Z]{2}-[0-9]{2}$</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
